<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name="Grouping" level="1" />
    <component name="Layering" level="1" />
    <component name="Text" level="1" />
    <meta name="title" content="LayerSet.x3d" />
    <meta name="identifier" content="https://coderextreme.net/X3DJSONLD/src/main/data/LayerSet.x3d" />
    <meta name="description" content="LayerSet with a 3D layer of a rotating box and a 2D layer of a Text string saying &quot; Hello, Layers&quot; and &quot;Goodbye, World&quot;" />
    <meta name="created" content="10 October 2026" />
    <meta name="creator" content="John Carlson" />
  </head>
  <Scene>
        <Background skyColor="0.1 0.1 0.15"></Background>

        <LayerSet activeLayer="1" order="1 2">
          <!-- Layer 0: Base 3D Model (Box) -->
          <Layer DEF="Layer0">
            <NavigationInfo type='"EXAMINE" "ANY"' headlight="true"></NavigationInfo>
            <Viewpoint DEF="VP_XITE" position="0 0 8" description="MainVP"></Viewpoint>
            
            <Transform DEF="BoxGeom" translation="0 0 0">
              <Shape>
                <Appearance>
                  <Material diffuseColor="0.2 0.7 0.9"></Material>
                </Appearance>
                <Box size="1.5 1.5 1.5"></Box>
              </Shape>
            </Transform>
          </Layer>

          <!-- Layer 1: Foreground Layer (Rendered on top of Layer 0) -->
          <Layer DEF="Layer1">
            <NavigationInfo headlight="true"></NavigationInfo>
            <Viewpoint DEF="VP_Layer1" position="0 0 8" description="Layer1VP"></Viewpoint>

            <!-- Centered directly over the Box face -->
            <Transform translation="0 0 0.8">
              <Shape>
                <Appearance>
                  <Material diffuseColor="1 1 1" emissiveColor="1 1 1"></Material>
                </Appearance>
                <Text string='"Layer 1" "Overlay Text"' solid="false">
                  <FontStyle family='"SANS"' justify='"MIDDLE" "MIDDLE"' size="0.45"></FontStyle>
                </Text>
              </Shape>
            </Transform>
          </Layer>
        </LayerSet>

        <!-- Keep Layer1 camera strictly synchronized with Layer0 -->
        <ROUTE fromNode="VP_XITE" fromField="position_changed" toNode="VP_Layer1" toField="set_position"/>
        <ROUTE fromNode="VP_XITE" fromField="orientation_changed" toNode="VP_Layer1" toField="set_orientation"/>
  </Scene>
</X3D>
