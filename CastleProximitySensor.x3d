<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE X3D PUBLIC "ISO//Web3D//DTD X3D 4.0//EN" "https://www.web3d.org/specifications/x3d-4.0.dtd">
<X3D profile='Immersive' version='4.0' xmlns:xsd='http://www.w3.org/2001/XMLSchema-instance' xsd:noNamespaceSchemaLocation='https://www.web3d.org/specifications/x3d-4.0.xsd'>
  <head>
    <component name="Grouping" level="1" />
    <component name="EnvironmentalSensor" level="1" />
    <component name="Scripting" level="1" />
    <component name="Text" level="1" />
    <meta name="title" content="CastleProximitySensor.x3d" />
    <meta name="description" content="A ProximitySensor keeps the Text locked in front of the viewer, centered over the Box. Mouse or trackpad navigation rotates the Box; the Text does not rotate. A CastleScript keeps the Box from ever reaching the Text when zooming in (fake zoom)." />
    <meta name="created" content="27 October 2026" />
    <meta name="creator" content="John Carlson" />
  </head>
  <Scene>
    <Background skyColor="0.1 0.1 0.15"></Background>
    <!-- Small avatarSize[0] pulls the near clipping plane in very close to the camera,
         so the Text can sit just in front of the lens without being clipped. -->
    <NavigationInfo type='"EXAMINE" "ANY"' headlight="true" avatarSize="0.01 1.6 0.75"></NavigationInfo>
    <Viewpoint DEF="Viewpoint" position="0 0 8" description="MainVP"></Viewpoint>

    <!-- Tracks the viewer's position and orientation; huge size so the viewer is always inside -->
    <ProximitySensor DEF="ViewerSensor" center="0 0 0" size="10000 10000 10000"></ProximitySensor>

    <!-- The Box lives in the world at the origin. Examine-mode dragging orbits the
         camera around it, so the Box appears to rotate with the mouse/trackpad.
         Once the camera is closer than rmin, ZoomGuard stops the Box from getting any
         nearer (it slides away along the view axis) and scales it up instead, so the
         zoom keeps looking like zooming, but no part of the Box can reach the Text. -->
    <Transform DEF="BoxGeom" translation="0 0 0" scale="1 1 1">
      <Shape>
        <Appearance>
          <Material diffuseColor="0.2 0.7 0.9"></Material>
        </Appearance>
        <Box size="1.5 1.5 1.5"></Box>
      </Shape>
    </Transform>

    <!-- The Text follows the viewer's position AND orientation, so it never rotates
         on screen. The inner offset parks it on the view axis only 0.05 units in front of
         the lens, so it is nearer than any part of the Box and stays in front when zooming.
         The scale (= 0.05 / 6.8) keeps its apparent size the same as when it sat 6.8
         units away. -->
    <Transform DEF="TextFollower">
      <Transform translation="0 0 -0.05" scale="0.00735 0.00735 0.00735">
        <Shape>
          <Appearance>
            <Material diffuseColor="1 1 1" emissiveColor="1 1 1"></Material>
          </Appearance>
          <Text string='"Layer 1" "Overlay Text"' solid="false">
            <FontStyle
              family='"Arial" "Helvetica" "SANS"'
              style="PLAIN"
              spacing="0.95"
              justify='"MIDDLE" "MIDDLE"'
              size="0.45">
            </FontStyle>
          </Text>
        </Shape>
      </Transform>
    </Transform>

    <!-- FAKE ZOOM (CastleScript). r = camera distance from the origin.
         rmin  : the Box is never allowed closer to the camera than this.
         smax  : maximum scale-up used to imitate zooming past rmin.
         Check: smax * 0.65 * sqrt(3) + 0.05 (Text distance) must stay below rmin:
         3.5 * 1.3 + 0.05 = 4.6 < 5. -->
    <Script DEF="ZoomGuard" url='"castlescript:
function camPos(value, timestamp)
  r := max(vector_length(value), 0.001);
  s := max(1.0, min(smax, rmin / r));
  f := max(rmin - r, 0.0) / r;
  scale_out := vector(s, s, s);
  trans_out := vector(-vector_get(value, 0) * f, -vector_get(value, 1) * f, -vector_get(value, 2) * f)
"'>
      <field name="camPos" type="SFVec3f" accessType="inputOnly"></field>
      <field name="rmin" type="SFFloat" accessType="initializeOnly" value="5"></field>
      <field name="smax" type="SFFloat" accessType="initializeOnly" value="3.5"></field>
      <field name="r" type="SFFloat" accessType="initializeOnly" value="8"></field>
      <field name="s" type="SFFloat" accessType="initializeOnly" value="1"></field>
      <field name="f" type="SFFloat" accessType="initializeOnly" value="0"></field>
      <field name="scale_out" type="SFVec3f" accessType="outputOnly"></field>
      <field name="trans_out" type="SFVec3f" accessType="outputOnly"></field>
    </Script>

    <ROUTE fromNode="ViewerSensor" fromField="position_changed" toNode="ZoomGuard" toField="camPos"></ROUTE>
    <ROUTE fromNode="ZoomGuard" fromField="scale_out" toNode="BoxGeom" toField="set_scale"></ROUTE>
    <ROUTE fromNode="ZoomGuard" fromField="trans_out" toNode="BoxGeom" toField="set_translation"></ROUTE>
    <ROUTE fromNode="ViewerSensor" fromField="position_changed" toNode="TextFollower" toField="set_translation"></ROUTE>
    <ROUTE fromNode="ViewerSensor" fromField="orientation_changed" toNode="TextFollower" toField="set_rotation"></ROUTE>
  </Scene>
</X3D>
